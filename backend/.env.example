# Copy this file to backend/.env and replace every REPLACE_WITH_ value.
# backend/.env is gitignored. Never commit real credentials or JWT secrets.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Generate a unique secret locally, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be at least 32 characters. Placeholders are rejected on startup.
JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET

# MySQL 8+ / MariaDB connection settings used by src/config/db.js.
# Use 3307 with the provided docker-compose.yml, or 3306 when connecting
# directly to a local MySQL/XAMPP instance.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=REPLACE_WITH_MYSQL_USERNAME
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
DB_NAME=Procument

# Supplier email delivery. The system uses one generic SMTP provider integration;
# use the host, port, username, password and sender approved by your organization.
# SMTP_SECURE=true is for implicit TLS on port 465. For STARTTLS on 587 use false.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
# Require STARTTLS when SMTP_SECURE=false. Keep true for production providers.
SMTP_REQUIRE_TLS=true
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_EMAIL
SMTP_FROM_NAME=Hope Haven Procurement
# Public frontend origin used to build each Supplier's signed quotation link.
# Do not use localhost here: recipients outside this computer cannot open it.
APP_BASE_URL=https://your-public-frontend.example.com
# Optional. Enables the generic delivery webhook used to record provider-confirmed
# Delivered, Bounced and Opened statuses. Obtain this value from your provider setup.
EMAIL_WEBHOOK_SECRET=

# Google Gmail inbox and send fallback. The OAuth consent screen needs Gmail
# readonly and send scopes. Set the OAuth Web client redirect URI to exactly the
# value below. Only an AES-256-GCM encrypted refresh token is stored in MySQL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/email/google/callback
GOOGLE_MAILBOX=procurement@hopehavenschool.org
# Generate a random 32-byte key locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the resulting 64-character hex string here. Keep this key private and back it up.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Used only by `npm run create-admin`. Leave ADMIN_PASSWORD blank until needed.
ADMIN_NAME=Hope Haven Administrator
ADMIN_EMAIL=admin@hopehaven.org
ADMIN_PASSWORD=
